# Rust source and lockfile
*.rs text diff=rust
Cargo.lock text
*.toml text

# Snapshot fixtures (insta)
*.snap text

# Binary assets and image snapshots
*.ttf binary
*.png binary

# Shell scripts and task runner
*.sh text eol=lf
justfile text eol=lf

# Documentation
*.md text diff=markdown

# Force LF line endings for cross-platform consistency
* text=auto eol=lf
