# keyvo: device access for the user at the seat (spec §3).
#
# `uaccess` gives the logged-in user of the active seat an ACL on the node
# (systemd-logind applies it in 73-seat-late.rules, hence the 70- prefix);
# no mode change, no group. The ACL follows the seat for new opens: a user
# who switches away cannot open the nodes again, but a descriptor opened
# before the switch stays valid (logind does not revoke hidraw or uinput).
#
# Install, then replug the Keypad:
#   sudo install -m 644 contrib/udev/70-keyvo.rules /etc/udev/rules.d/
#   sudo udevadm control --reload && sudo udevadm trigger
# Check: keyvo doctor; getfacl /dev/uinput lists the user.

# MX Creative Keypad, USB 046d:c354: every hidraw node of the device.
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c354", TAG+="uaccess"

# Logi Bolt receiver, USB 046d:c548: the MX Creative Dialpad's path
# (beta slice 6). Only the receiver's HID++ node, USB interface 02
# (docs/hardware-notes.md, record D8). It carries the HID++ reports 10 and
# 11 of every paired device: measured, nothing while no control is
# diverted, the Dialpad's button and roller reports while keyvo diverts
# them; no keyboard or mouse input. Whoever opens it can talk HID++ to
# every paired device, as Solaar does. The receiver's other interfaces
# stay closed: 00 carries what is typed on a paired keyboard, 01 the
# reports of a paired mouse (and of the undiverted Dialpad), 03 is a
# digitizer. The kernel runs the receiver without per-device nodes here;
# where it gives a paired device a node of its own, that node carries the
# device's product id in its immediate HID parent and does not match.
# One ATTRS key only: udev matches all ATTRS keys of a rule on one parent.
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", IMPORT{parent}="HID_ID", ENV{HID_ID}=="0003:0000046D:0000C548", ATTRS{bInterfaceNumber}=="02", TAG+="uaccess"

# /dev/uinput: the daemon's virtual keyboard for chord keys.
# static_node lets the tag apply before the uinput module is loaded.
KERNEL=="uinput", SUBSYSTEM=="misc", OPTIONS+="static_node=uinput", TAG+="uaccess"
