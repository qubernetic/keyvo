  "cards": [
    {
      "dot": "emerald",
      "title": "Page change",
      "items": [
        "All nine buttons are drawn into the one canvas and sent as the union rectangle",
        "The device renders one image: no background-then-keys wipe",
        "Bands only when the encoded crop exceeds maxImageSize (124928 bytes)"
      ]
    },
    {
      "dot": "rose",
      "title": "Single button",
      "items": [
        "Same path with one dirty button: the crop is its 118x118 reported area",
        "116x116 content at the top-left, 2 px of black canvas right and bottom",
        "Pressed state: the icon shrunk by a fixed ratio, centred on black"
      ]
    },
    {
      "dot": "orange",
      "title": "What keyvo copies",
      "items": [
        "One composite image per change, cropped to the dirty bounding box",
        "Send the next image after the fn2 response, keep two pending, drop stale",
        "No deferred update, no multi-image command, no ClearScreen"
      ]
    }
  ]
}
