{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Options+ display update pipeline (reference)",
    "subtitle": "Facts from docs/research/options-plus-display-pipeline.md (2026-10-25, Logi Plugin Service 6.4.2); sizes are the owner's MX Creative Keypad, firmware U1 66.00.B0017",
    "visual_preset": "signal-flow",
